# Copy to `.env` and fill in. `.env` is git-ignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Relative `file:` paths resolve against the `prisma/` directory, matching
# Prisma CLI behaviour (see src/server/db/datasource.ts). The default below is
# therefore `prisma/dev.db`. To use PostgreSQL instead, set a postgres:// URL
# here and change `provider` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Without it the app runs in a clearly-labelled degraded mode: retrieval and
# every non-AI feature work, but drafting and chat return an explicit notice
# instead of fabricated text.
GEMINI_API_KEY=""

# Optional model overrides.
GEMINI_TEXT_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Directory for uploaded source documents. Resolved against the project root.
# On a hosted deployment this must point at a persistent volume.
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_MB="25"

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Set to "1" to require HTTPS-only session cookies. Enable in production.
SECURE_COOKIES="0"
